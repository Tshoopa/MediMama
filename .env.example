# ================================================================
# ONE CODEBASE, TWO RUNTIME MODES
# ================================================================
# Mode 1 - GitHub/local-model showcase:
#   INFERENCE_MODE=local
#   Install: pip install -r requirements-local.txt
#   Runs Google MedGemma 1.5 4B locally (Hugging Face gated access required).
#   RAG embeddings/reranking/semantic helpers also use local models.
#
# Mode 2 - API-only demo hosting:
#   INFERENCE_MODE=api
#   Install: pip install -r requirements.txt
#   Answer generation, translation and embeddings use OpenAI API.
#   No local LLM, PyTorch, Transformers, SentenceTransformers or reranker.
# ================================================================
INFERENCE_MODE=api

# ── OpenAI (required in API mode; optional in local mode) ──
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.gapgpt.app/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSLATION_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_TIMEOUT_SECONDS=30

# Translation: auto = local MedGemma in local mode, OpenAI in API mode.
TRANSLATION_BACKEND=auto

# Local model
LOCAL_MODEL_ID=Qwen/Qwen3-4B-Instruct-2507
# Optional Hugging Face token.
# Qwen model is public; gated MedGemma access is not required.
HF_TOKEN=
#HF_TOKEN=your_huggingface_read_token
LOCAL_DEVICE_MAP=auto
# auto chooses float16 on CUDA and float32 on CPU. Use bfloat16 only on supported GPUs.
LOCAL_MODEL_DTYPE=float16
LOCAL_MAX_NEW_TOKENS=220
LOCAL_TRANSLATION_MAX_NEW_TOKENS=512
LOCAL_TEMPERATURE=0.1
LOCAL_REPETITION_PENALTY=1.0
LOCAL_MODEL_CACHE_DIR=./.model_cache

# ── Embeddings / retrieval ─────────────────────────────────────────
# auto = local embeddings in local mode, OpenAI embeddings in API mode.
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=pritamdeka/S-PubMedBert-MS-MARCO
EMBEDDING_BATCH_SIZE=64
RETRIEVAL_DEVICE=cpu
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_DEVICE=cpu
SEMANTIC_MODELS_ENABLED=true
SEMANTIC_EMBEDDING_MODEL=all-MiniLM-L6-v2
SEMANTIC_DEVICE=cpu
ENABLE_QUERY_EXPANSION=false
TOP_K=6
DENSE_CANDIDATE_K=25
SPARSE_CANDIDATE_K=25
RERANK_POOL_SIZE=15

# ── Qdrant ─────────────────────────────────────────────────────────
# For local Docker Compose, leave URL empty; Compose sets QDRANT_HOST=qdrant.
# For a cloud Qdrant cluster, set QDRANT_URL and QDRANT_API_KEY.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_HOST=localhost
QDRANT_PORT=6333
# Leave empty to auto-use medimama_local or medimama_api, avoiding vector-dimension conflicts.
COLLECTION_NAME=

# ── Optional API-based triage assists (additional API cost) ─────────
# These are supplementary only. Deterministic triage rules remain authoritative.
LLM_SAFETY_NET=false
LLM_FEATURE_ASSIST=false
EAGER_SAFETY_NET=false
LLM_TIMEOUT_SECONDS=15
LLM_DEBUG=false
LLM_ONLY_IF_BASE_LEVEL_GREATER_THAN=2
FALLBACK_FLOOR_ENABLED=true

# ── Privacy ────────────────────────────────────────────────────────
# Keep false for public demos. Stores raw parent message, age and answer only if true.
AUDIT_LOG_SENSITIVE_FIELDS=false

# ── Web server / CORS ──────────────────────────────────────────────
PORT=8000
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Add the exact origin of your hosted frontend; do not use wildcard origins.

# ── Optional Colab tunnel ──────────────────────────────────────────
NGROK_AUTH_TOKEN=
