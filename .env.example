# ── Safety-net LLM (OpenAI-compatible provider) ─────────────────────────
# Tested with DeepSeek. Works unchanged with OpenAI, Groq, Together, or vLLM.
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=12

# ── Local generation model ──────────────────────────────────────────────
MODEL_PATH=./models/meditron-7b.Q4_K_M.gguf
LLM_N_GPU_LAYERS=-1
LLM_CONTEXT_SIZE=4096
MAX_NEW_TOKENS=200
TEMPERATURE=0.1

# ── Vector store ────────────────────────────────────────────────────────
# Docker Compose sets QDRANT_HOST=qdrant automatically.
QDRANT_HOST=localhost
QDRANT_PORT=6333
COLLECTION_NAME=medimama

# Alternative: embedded on-disk Qdrant. Leave empty to use host/port above.
# QDRANT_PATH=./qdrant_storage

# ── Retrieval ───────────────────────────────────────────────────────────
TOP_K=6
RERANK_POOL_SIZE=15
ENABLE_QUERY_EXPANSION=false

# ── CORS ────────────────────────────────────────────────────────────────
# Comma-separated browser origins allowed to call the API. No wildcards.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Serving the frontend through a tunnel? Add that exact origin:
# ALLOWED_ORIGINS=http://localhost:8000,https://your-tunnel.ngrok-free.app

# ── Colab demo only (see demo_colab.py) ─────────────────────────────────
# NGROK_AUTH_TOKEN=your_ngrok_token_here